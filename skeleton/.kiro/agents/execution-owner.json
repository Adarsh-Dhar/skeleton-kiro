        "capability": "fs_write",
        "match": [
          "**"
        ],
        "exclude": [
          "packages/trialforge-core/src/trialforge/execution/**",
          "packages/trialforge-core/src/trialforge/persistence/**",
          "packages/trialforge-core/src/trialforge/history/**",
